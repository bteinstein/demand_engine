    "from fuzzywuzzy import process\n",
    "# Or: from rapidfuzz import process\n",
    "import pandas as pd\n",
    "\n",
    "# Sample setup (your real data is larger)\n",
    "df_sp = df_sp_mapped_location.copy()[['State_Name', 'LGA_Name', 'LCDA_Name']].drop_duplicates()\n",
    "df_ng = df_ng_wards.copy()[['State_Name', 'LGA_Name', 'LCDA_Name']].drop_duplicates()\n",
    "\n",
    "# Ensure lowercased comparison\n",
    "df_sp[['State_Name', 'LGA_Name', 'LCDA_Name']] = df_sp[['State_Name', 'LGA_Name', 'LCDA_Name']].apply(lambda col: col.str.lower())\n",
    "df_ng[['State_Name', 'LGA_Name', 'LCDA_Name']] = df_ng[['State_Name', 'LGA_Name', 'LCDA_Name']].apply(lambda col: col.str.lower())\n",
    "\n",
    "# Function to fuzzy match LCDA\n",
    "def fuzzy_match_lcda(row):\n",
    "    state = row['State_Name']\n",
    "    lga = row['LGA_Name']\n",
    "    lcda_raw = row['LCDA_Name']\n",
    "\n",
    "    # Filter df_ng for same state and lga\n",
    "    candidates = df_ng[(df_ng['State_Name'] == state) & (df_ng['LGA_Name'] == lga)]\n",
    "    lcda_choices = candidates['LCDA_Name'].unique()\n",
    "\n",
    "    if len(lcda_choices) == 0:\n",
    "        return pd.Series([None, 0])\n",
    "\n",
    "    match, score = process.extractOne(lcda_raw, lcda_choices)\n",
    "    return pd.Series([match, score])\n",
    "\n",
    "# Apply fuzzy match\n",
    "df_sp[['Matched_LCDA', 'Match_Score']] = df_sp.apply(fuzzy_match_lcda, axis=1)\n",
    "\n",
    "# Optionally filter low-quality matches\n",
    "df_sp_filtered = df_sp[df_sp['Match_Score'] >= 80]  # tweak threshold as needed\n",
    "\n",
    "# Now join with boundary\n",
    "df_final = df_sp_filtered.merge(\n",
    "    df_ng,\n",
    "    left_on=['State_Name', 'LGA_Name', 'Matched_LCDA'],\n",
    "    right_on=['State_Name', 'LGA_Name', 'LCDA_Name'],\n",
    "    how='inner',\n",
    "    suffixes=('_sp','_ng')\n",
    ").sort_values('Match_Score', ascending=False)\n",
    "\n",
    "A = df_final.shape[0]\n",
    "B = df_sp.shape[0]\n",
    "print(A, \"/\", B,\" {\",round(A/(B*1.0),3),\"}\")"
   ]
  },
