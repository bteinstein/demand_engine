    "import pandas as pd\n",
    "\n",
    "def clean_sp_lcda_name(lcda_name, lga_name):\n",
    "    parts = [part.strip() for part in lcda_name.split('-')]\n",
    "    if len(parts) == 2 and parts[0] == lga_name:\n",
    "        return parts[1]\n",
    "    return lcda_name\n",
    "\n",
    "def clean_ng_lcda_name(lcda_name, lga_name):\n",
    "    parts = [part.strip() for part in lcda_name.split('/')]\n",
    "    if len(parts) == 2 and parts[0] == lga_name:\n",
    "        return parts[1]\n",
    "    return lcda_name\n",
    "\n",
