    "from fuzzywuzzy import process, fuzz\n",
    "\n",
    "def match_cleaned_lcda(row):\n",
    "    state = row['State_Name']\n",
    "    lga = row['LGA_Name']\n",
    "    lcda = row['Cleaned_LCDA']\n",
    "\n",
    "    candidates = df_ng[\n",
    "        (df_ng['State_Name'] == state) & (df_ng['LGA_Name'] == lga)\n",
    "    ]\n",
    "    lcda_choices = candidates['Cleaned_LCDA'].unique()\n",
    "\n",
    "    if len(lcda_choices) == 0:\n",
    "        return pd.Series([None, 0])\n",
    "\n",
    "    match, score = process.extractOne(lcda, lcda_choices, scorer=fuzz.token_sort_ratio)\n",
    "    return pd.Series([match, score])\n",
    "\n",
    "# Run matching\n",
    "df_sp[['Matched_LCDA', 'Match_Score']] = df_sp.apply(match_cleaned_lcda, axis=1)\n",
    "\n",
    "# Filter and merge\n",
    "df_sp_matched = df_sp[df_sp['Match_Score'] >= 80]\n",
    "\n",
    "df_final = df_sp_matched.merge(\n",
    "    df_ng,\n",
    "    left_on=['State_Name', 'LGA_Name', 'Matched_LCDA'],\n",
    "    right_on=['State_Name', 'LGA_Name', 'Cleaned_LCDA'],\n",
    "    how='left',\n",
    "    suffixes=('', '_ng')\n",
    ").sort_values('Match_Score', ascending=False)\n",
    "\n",
    "A = df_final.shape[0]\n",
    "B = df_sp.shape[0]\n",
    "print(A, \"/\", B,\" {\",round(A/(B*1.0),3),\"}\")\n"
   ]
